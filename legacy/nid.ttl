@prefix : <http://ontobdc.org/ontology/domain/nid.ttl#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix ontouml: <http://w3id.org/ontouml#> .
@prefix obdc: <http://ontobdc.org/ontology/domain/ontobdc/ns.ttl#> .

@base <http://ontobdc.org/ontology/domain/nid.ttl#> .

<http://ontobdc.org/ontology/domain/nid.ttl> rdf:type owl:Ontology ;
    owl:imports <http://ontobdc.org/ontology/domain/ontobdc/ns.ttl> .

###  http://ontobdc.org/ontology/domain/nid.ttl#EtlProcessState.SANITIZED
:EtlProcessState.SANITIZED rdf:type owl:NamedIndividual ,
                                    obdc:EtlProcessState ;
                           ontouml:name "Sanitized"@en ;
                           rdfs:comment "ETL process state: sanitized."@en .
