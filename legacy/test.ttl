                                      sdo:hasParameter :sysargsStorageHelp ;
                                      ontouml:targetEnd obdc_code:CliCommandRunAdapter_make .


###  http://ontobdc.org/ontology/domain/test.ttl#OntoBDCCore
:OntoBDCCore rdf:type owl:NamedIndividual ,
                      obdc_code:OntoBDCApplication ;
             obdc_code:hasStartAction :OntoBDCCoreCliMain ;
             schema:codeRepository <https://github.com/OntoBDC/ontobdc-core> ;
             schema:description "OntoBDC Core application."@en ;
             schema:name "Core" .


###  http://ontobdc.org/ontology/domain/test.ttl#OntoBDCCoreCliMain
:OntoBDCCoreCliMain rdf:type owl:NamedIndividual ,
                             obdc_code:CliStartAction ;
                    schema:description "Main CLI entrypoint for OntoBDC Core."@en ;
                    schema:name "main" .


###  http://ontobdc.org/ontology/domain/test.ttl#OntobdcCliHelpResponse
:OntobdcCliHelpResponse rdf:type owl:NamedIndividual ,
                                 obdc_code:HelpCommandResponse ;
                        schema:description "Display help information for the CLI."@en ;
                        schema:name "CLI Help" .


###  http://ontobdc.org/ontology/domain/test.ttl#OntobdcVersionResponse
:OntobdcVersionResponse rdf:type owl:NamedIndividual ,
                                 obdc_code:CommandResponse ;
                        schema:description "Display the package version." ;
                        schema:name "OntoBDC Version" .


###  http://ontobdc.org/ontology/domain/test.ttl#TestCliCommandPortContractOntobdcVersion
:TestCliCommandPortContractOntobdcVersion rdf:type owl:NamedIndividual ,
                                                   obdc_code:UnitTest ;
                                          schema:description "Valida se as implementações do CliCommandPort respeitam o contrato das três assinaturas."@pt-br ;
                                          schema:instrument :CliMainInvokesMakeForVersion ;
                                          schema:object :CliMainInvokesMakeForVersion ;
                                          schema:name "test_cli_command_port_contract" ;
                                          schema:result :OntobdcVersionResponse .


###  http://ontobdc.org/ontology/domain/test.ttl#TestOntobdcReturnsCliHelpWithoutWarnings
:TestOntobdcReturnsCliHelpWithoutWarnings rdf:type owl:NamedIndividual ,
                                                  obdc_code:UnitTest ;
                                         schema:description "Valida se o comando ontobdc retorna a ajuda da CLI sem warnings de carregamento de plugins."@pt-br ;
                                         schema:instrument :CliMainInvokesMakeForNone ;
                                         schema:name "test_ontobdc_returns_cli_help_without_warnings" ;
                                         schema:object :CliMainInvokesMakeForNone ;
                                         schema:result :OntobdcCliHelpResponse .


###  http://ontobdc.org/ontology/domain/test.ttl#sysargsHelp
:sysargsHelp rdf:type owl:NamedIndividual ,
                      obdc_code:cliArgv ;
             rdf:value "ontobdc --help" .


###  http://ontobdc.org/ontology/domain/test.ttl#sysargsNone
:sysargsNone rdf:type owl:NamedIndividual ,
                      obdc_code:cliArgv ;
             rdf:value "ontobdc" .


###  http://ontobdc.org/ontology/domain/test.ttl#sysargsStorage
:sysargsStorage rdf:type owl:NamedIndividual ,
                         obdc_code:cliArgv ;
                rdf:value "ontobdc storage" .


###  http://ontobdc.org/ontology/domain/test.ttl#sysargsStorageHelp
:sysargsStorageHelp rdf:type owl:NamedIndividual ,
                             obdc_code:cliArgv ;
                    rdf:value "ontobdc storage --help" .


###  http://ontobdc.org/ontology/domain/test.ttl#sysargsVersion
:sysargsVersion rdf:type owl:NamedIndividual ,
                         obdc_code:cliArgv ;
                rdf:value "ontobdc --version" .


:sysargsResourceLoaderValidation rdf:type owl:NamedIndividual ,
                                          obdc_code:cliArgv ;
                                 rdf:value "ontobdc resource-loader validate" .


:ResourceLoaderValidatesContract rdf:type owl:NamedIndividual ,
                                          obdc_code:ActionInvocationRelation ;
                                 sdo:hasParameter :sysargsResourceLoaderValidation ;
                                 ontouml:targetEnd obdc_code:inspect_resource_loader .


:ResourceLoaderValidationResponse rdf:type owl:NamedIndividual ,
                                           obdc_code:CommandResponse ;
                                  schema:description "Validate resource strategy order and file mapping."@en ;
                                  schema:name "Resource Loader Validation" ;
                                  rdf:value (
                                      [
                                          schema:name "strategy_order" ;
                                          schema:value "PdfTextFileResourceStrategy,TextFileResourceStrategy,LocalFileResourceStrategy" ;
                                          schema:valueReference xsd:string
                                      ]
                                      [
                                          schema:name "PdfTextFileResourceStrategy" ;
                                          schema:value "storage/plugin/resource/pdf.py" ;
                                          schema:valueReference xsd:string
                                      ]
                                      [
                                          schema:name "TextFileResourceStrategy" ;
                                          schema:value "storage/plugin/resource/text.py" ;
                                          schema:valueReference xsd:string
                                      ]
                                      [
                                          schema:name "LocalFileResourceStrategy" ;
                                          schema:value "storage/plugin/resource/standard.py" ;
                                          schema:valueReference xsd:string
                                      ]
                                  ) .


:TestResourceLoaderContract rdf:type owl:NamedIndividual ,
                                     obdc_code:UnitTest ;
                            schema:description "Valida a ordem e o de-para de arquivos das strategies de resource."@pt-br ;
                            schema:instrument :ResourceLoaderValidatesContract ;
                            schema:name "test_resource_loader_contract" ;
                            schema:object :ResourceLoaderValidatesContract ;
                            schema:result :ResourceLoaderValidationResponse .


