                              ontouml:targetEnd obdc_code:CliCommandRunAdapter_make .


###  http://ontobdc.org/ontology/domain/test.ttl#CliMainInvokesMakeOntobdcStorage
:CliMainInvokesMakeOntobdcStorage rdf:type owl:NamedIndividual ,
                                           obdc_code:CliMainInvokesMake ;
                                  sdo:hasParameter :sysargsStorage ;
                                  ontouml:targetEnd obdc_code:CliCommandRunAdapter_make .


###  http://ontobdc.org/ontology/domain/test.ttl#CliMainInvokesMakeOntobdcStorageHelp
